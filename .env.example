# SafetyRAISE 服务器部署环境变量示例
#
# 用法：复制为仓库根目录的 .env.server（已被 .gitignore 忽略），逐项替换 <...> 占位与空值后，
# 由 deployment/docker/server-compose.sh 读取。本文件只列变量名和安全的示例值，不保存任何真实凭据。
# 变量含义与默认值见 docs/configuration.md，部署拓扑见 docs/deployment.md。

# ---------- 宿主机目录 ----------
# 知识库以只读方式挂载进后端；可以是本机目录，也可以是从数据主机挂载过来的目录。
KBASE_HOST_PATH=/srv/safetyraise/kbase
# 后端运行数据（上传、会话产物、报告输出），需要可写并纳入备份。
BACKEND_DATA_HOST_PATH=/srv/safetyraise/runtime
# YOLO 权重等模型文件。
MODELS_HOST_PATH=/srv/safetyraise/models
FRONTEND_NGINX_HOST_PATH=/srv/safetyraise/nginx
LETSENCRYPT_CONF_HOST_PATH=/srv/safetyraise/letsencrypt/conf
LETSENCRYPT_WWW_HOST_PATH=/srv/safetyraise/letsencrypt/www

# ---------- 域名与 HTTPS（setup-https.sh / renew-https.sh 读取） ----------
LETSENCRYPT_PRIMARY_DOMAIN=example.com
LETSENCRYPT_DOMAINS=example.com
LETSENCRYPT_EMAIL=
FRONTEND_PORT=80
FRONTEND_HTTPS_PORT=443

# ---------- 通用运行参数 ----------
TZ=Asia/Shanghai
# 视频链路依赖（ultralytics、lap）。ultralytics 采用 AGPL-3.0，启用前请阅读 README 的许可说明。
INSTALL_VIDEO_DEPS=true
VITE_API_BASE=
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3
BACKEND_MEMORY_LIMIT=1536m
BACKEND_CPU_LIMIT=2
BACKEND_PIDS_LIMIT=256
BACKEND_MATH_THREADS=2
FRONTEND_MEMORY_LIMIT=128m
FRONTEND_CPU_LIMIT=0.5
FRONTEND_PIDS_LIMIT=64

# ---------- 数据库与鉴权 ----------
# 同机部署填 Docker 网络内的数据库服务名；分机部署填数据库主机地址，且数据库端口不要暴露到公网。
DATABASE_DSN=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/safetyraise
# 生产配置会拒绝空值或公开默认值，请用 `openssl rand -hex 32` 之类的方式生成。
AUTH_JWT_SECRET=
BOOTSTRAP_ADMIN_USERNAME=safetyraise
# 首次启动创建管理员用的初始口令：至少 8 位，只保存在部署环境；生产配置下为空会拒绝启动。
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=SafetyRAISE 管理员

# ---------- 专家模型（系统级，OpenAI 兼容） ----------
# 可用 deployment/modal/qwen3_expert.py 自行部署，或接入 vLLM、LM Studio 等兼容服务。
EXPERT_LOCAL_PROVIDER=openai_compatible
EXPERT_LOCAL_MODEL=suyuan37/SafetyRAISE-TS-Qwen3
EXPERT_LOCAL_BASE_URL=https://<EXPERT_ENDPOINT>/v1
# 值是“保存令牌的环境变量名”，令牌本身写在下一行对应的变量里。
EXPERT_LOCAL_API_KEY_ENV=MODAL_EXPERT_PROXY_TOKEN
MODAL_EXPERT_PROXY_TOKEN=

# ---------- 报告、视觉与嵌入模型 ----------
# 默认报告端点、视觉模型与嵌入模型都经 OpenRouter 调用。
OPENROUTER_API_KEY=
# 嵌入模型必须与知识库稠密索引构建时一致（默认 qwen/qwen3-embedding-8b，4096 维），更换需重建索引。
RETRIEVAL_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
RETRIEVAL_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
RETRIEVAL_EMBEDDING_API_KEY_ENV=OPENROUTER_API_KEY
# reranker 默认停用；只有在配置中启用并部署独立服务时才需要填写。
RETRIEVAL_RERANKER_BASE_URL=http://retrieval-reranker:80
RETRIEVAL_RERANKER_MODEL=Alibaba-NLP/gte-multilingual-reranker-base
RETRIEVAL_RERANKER_API_KEY_ENV=

# ---------- 可选：知识库与 YOLO 路径覆写 ----------
# 不填时使用 workflow 配置中的默认路径；YOLO 权重默认位于 models/yolo11n.pt。
KBASE_MANIFEST_PATH=
KBASE_CHUNKS_PATH=
KBASE_RULES_PATH=
KBASE_SEARCH_INDEX_PATH=
KBASE_DENSE_MANIFEST_PATH=
KBASE_DENSE_RECORDS_PATH=
KBASE_DENSE_VECTORS_PATH=
YOLO_MODEL_PATH=

# ---------- 可选：报告 Harness 部署覆盖层（docker-compose.harness.yml） ----------
# 只在叠加 Harness 覆盖层时需要；各项要求见 docs/deployment.md。
# BACKEND_RUNTIME_BASE_IMAGE=sha256:<verified-backend-image-id>
# FRONTEND_RUNTIME_BASE_IMAGE=sha256:<verified-nginx-image-id>
# FRONTEND_RUNTIME_CONTEXT_HOST_PATH=/srv/safetyraise/frontend-runtime
# HARNESS_WORKFLOW_CONFIG_HOST_PATH=/srv/safetyraise/harness/workflow.server.yaml
# HARNESS_MANIFEST_HOST_PATH=/srv/safetyraise/harness/runtime-manifest.json
# HARNESS_RELEASE_DIR_HOST_PATH=/srv/safetyraise/harness/release
# HARNESS_LOCAL_LEDGER_HOST_DIR=/srv/safetyraise/harness/ledger
# HARNESS_LOCAL_TMP_HOST_DIR=/srv/safetyraise/harness/tmp
# HARNESS_UID=10001
# HARNESS_GID=10001
